{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Categories</h2>

    <section id="categories">

        {% for cat in cat_data %}

            <div class="cat_data">

                <header>
                    <h3>{{ cat.name }}</h3>
                </header>

                <p>Total: ${{ cat.total }}</p>

            </div>

        {% else %}

            <p>No Categories!</p>

        {% endfor %}

    </section>

    <div>

        <a href="/timeline" class="timeline_button">View Timeline</a>
        <a href="/add_cat" class="add-cat_button">Add Category</a>
    
    </div>


{% endblock %}

