{#=====================================================
  Add category page
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block content %}

    <section id="label">

        <label for="name">Category Name:</label>
            <input
                type="text"
                id="name"
                name="name"
                placeholder="e.g. Food"
                required
            >

        <label for="budget">Budget: $</label>
                <input
                    type="number"
                    id="budget"
                    name="budget"
                    min="0"
                    value="0"
                    required
                >

        <label for="notes">Notes:</label>
            <textarea
                id="notes"
                name="notes"
                placeholder="Enter category notes..."
            ></textarea>

    </section>

        <br><br>

            <button type="submit">Add Category</button>

        </form>

         <br><br>

         <hr>

        <h2>Existing Categories</h2>

        <section id="add_categories">

            {% for cat in cat_data %}

                <div class="add_cat">
                    <header>
                        <h3>{{ cat.name }}</h3>
                    </header>

                    <p>Budget: ${{ cat.budget }}</p>
                    <p>Notes: {{ cat.notes }}</p>
                    
                    <footer>
                    </footer>

                </div>

            {% else %}

                <p>No categories!</p>

            {% endfor %}

        </section>

{% endblock %}
