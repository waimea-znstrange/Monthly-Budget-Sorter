  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}

{% block content %}

    <label for="budget">Budget:</label>
            <input
                type="number"
                id="budget"
                name="budget"
                min="0"
                value="0"
                required
            >

            <br><br>

            <button type="submit">Add Category</button>

        </form>

         <br><br>

         <hr>

        <h2>Existing Categories</h2>

        <section id="add_categories">

            {% for cat in cat_data %}

                <div class="add_cat">
                    <header>
                        <h3>{{ cat.name }}</h3>
                    </header>

                    <p>Budget: ${{ cat.budget }}</p>
                    <p>Notes: {{ cat.notes }}</p>
                    
                    <footer>
                    </footer>

                </div>

            {% else %}

                <p>No categories!</p>

            {% endfor %}

        </section>

{% endblock %}
