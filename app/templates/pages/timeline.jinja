{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Timeline</h2>

    <section id="timeline">

        {% for spending in cat_data %}

            <div class="timeline">

                <header>
                    <h3>{{ Timeline }}</h3>
                </header>

                    <p>{{ spending.date }}</p>
                    <p>{{ spending.reason }}</p>
                    <p>${{ spending.amount }}</p>

                <footer>
                </footer>

            </div>

        {% else %}

            <p>No Dates!</p>

        {% endfor %}

    </section>

{% endblock %}

